# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Tenant scope for phone linking (required in multi-clinic)
TELEGRAM_DEFAULT_CLINIC_ID=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# API Configuration — use a long random secret, never ship in browser
API_KEY=
PORT=3001

# Development/Production
NODE_ENV=development

# TextUp SMS (loyiha ildizidagi .env dan ham o'qiladi)
# TEXTUP_EMAIL=your@email.uz
# TEXTUP_PASSWORD=your_password
# TEXTUP_USER_ID=your_user_uuid
