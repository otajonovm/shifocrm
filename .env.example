# ShifoCRM Environment Variables
# Bu fayl namuna sifatida. .env fayl yarating va qiymatlarni kiriting.

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram browser secret ishlatilmaydi. Server/Edge secret sifatida sozlang:
# TELEGRAM_BOT_API_URL=https://your-bot-domain.com
# TELEGRAM_BOT_API_KEY=rotate-with-a-long-random-secret

# Keshbek / Telegram bot (frontend). Dev da Vite proxy orqali chaqiriladi.
# VITE_TELEGRAM_API_URL=https://sea-lion-app-9vj5b.ondigitalocean.app
# VITE_TELEGRAM_API_KEY=botdagi_BOT_API_KEY_bilan_bir_xil

# Daftar rasm import (vision)
# API kalitlar faqat Supabase Edge Function secrets ichida bo'lishi kerak:
# GEMINI_API_KEY=your_gemini_api_key
# VITE_VISION_MODEL=gemini-flash-latest
# OPENAI_API_KEY=your_openai_api_key
# VITE_VISION_MODEL=gpt-4o
# DEEPSEEK_API_KEY=your_deepseek_api_key

# legacy-auth Edge Function secrets:
# APP_JWT_SECRET=project-jwt-secret
# LEGACY_SUPERADMIN_LOGIN=superadmin
# LEGACY_SUPERADMIN_PASSWORD_HASH=$2b$12$...

# TextUp SMS (faqat server: telegram-bot / Edge Functions — frontend ga qo'ymang!)
# TEXTUP_EMAIL=your@email.uz
# TEXTUP_PASSWORD="your_password"
# TEXTUP_API_KEY=your_api_key
# TEXTUP_API_SECRET=your_api_secret
# TEXTUP_USER_ID=your_user_uuid
# TEXTUP_SEND_NAME=ShifoCRM
# TEXTUP_TEMPLATE_ID=your_template_uuid
# TextUp tasdiqlagan shablon matni (boshqa matn ketmaydi):
# TEXTUP_TEST_MESSAGE=Alisher! Bugungi davolanish uchun hisobingizga 25,000 so'm keshbek tushdi. Balansni ko'rish va keyingi to'lovda ishlatish uchun botimizga kiring: t.me/shifocrm_bot
